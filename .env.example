# Copier ce fichier en .env et renseigner de vraies valeurs avant de
# lancer `docker compose up`. Ne jamais committer le .env réel.

POSTGRES_DB=kairos
POSTGRES_USER=kairos
# Mot de passe de la base. Pris en compte UNIQUEMENT à la toute première
# création du volume kairos_pgdata : le changer ici plus tard ne change pas
# celui de la base (il faut aussi le changer dans Postgres avec ALTER USER),
# sinon l'appli ne peut plus s'y connecter.
POSTGRES_PASSWORD=change-moi

# Clé utilisée par Flask pour signer les sessions (cookies de connexion).
# Générer une valeur aléatoire d'au moins 32 caractères, par exemple avec :
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# L'appli REFUSE de démarrer avec une clé plus courte ou avec la valeur
# d'exemple ci-dessous (voir app/__init__.py).
SECRET_KEY=change-moi-aussi

# "production" désactive le mode debug de Flask (recommandé dès que
# l'appli est accessible par d'autres personnes que toi).
FLASK_ENV=production

# URL publique de l'application (sans / final), ex.
# https://kairos.example.com ou http://192.168.1.20:8000 — utilisée pour construire les liens
# ABSOLUS envoyés par email (mot de passe oublié, création de compte).
# Laisser vide envoie un lien relatif (ne fonctionnera pas dans un email) :
# voir la note de sécurité dans app/config.py (Host header non fiable).
APP_BASE_URL=http://192.168.1.20:8000

# Laisser à false tant que l'appli tourne en HTTP simple sur le LAN (sans
# certificat) — sinon le cookie de session n'est plus jamais envoyé et
# personne ne peut se connecter. À passer à true uniquement une fois un
# reverse proxy HTTPS mis en place devant l'appli (revue sécurité, 2026-09-20).
# OBLIGATOIRE à true dès que APP_BASE_URL commence par https:// (sinon le
# cookie de session, valable 30 jours, peut circuler en clair).
SESSION_COOKIE_SECURE=false

# Nombre de reverse proxys de confiance devant l'appli (ex. 1 pour Nginx
# Proxy Manager). 0 = accès direct. Indispensable derrière un proxy :
# sinon tous les utilisateurs ont l'IP du proxy, et la protection contre
# les essais de mots de passe finit par bloquer tout le monde.
TRUSTED_PROXY_COUNT=0

# Adresses d'où les en-têtes X-Forwarded-* (IP réelle du client, https)
# sont crus : l'adresse du reverse proxy TELLE QUE L'APPLI LA VOIT, en IP
# ou en réseau CIDR, séparées par des virgules. Toute autre adresse (un
# poste du LAN qui vise directement le port 8000) est traitée avec son
# adresse TCP réelle, en-têtes ignorés, et signalée une fois dans
# `docker compose logs web` (« En-têtes X-Forwarded-* ignorés : requête
# reçue directement de <IP> ») : si <IP> est celle du proxy, l'ajouter ici.
# Vide : réseaux Docker 172.16.0.0/12 + 127.0.0.1 + HOST_IP (avertissement
# au démarrage si WEB_BIND n'est pas 127.0.0.1). Exemple pour Nginx Proxy
# Manager en conteneur sur le même serveur :
#   TRUSTED_PROXY_IPS=172.16.0.0/12
TRUSTED_PROXY_IPS=

# IP LAN du serveur (facultative), ajoutée à la liste par défaut ci-dessus
# quand TRUSTED_PROXY_IPS est vide. Ex. HOST_IP=192.0.2.17
HOST_IP=

# Adresse sur laquelle le port 8000 est publié. 0.0.0.0 = joignable depuis
# tout le LAN (accès direct, ou reverse proxy en conteneur qui vise l'IP du
# serveur). 127.0.0.1 = joignable seulement depuis le serveur (reverse
# proxy installé sur le serveur lui-même, hors conteneur) : personne ne
# contourne le proxy en HTTP. L'appli démarre dans les deux cas.
WEB_BIND=0.0.0.0

# Durée de vie maximale d'une session, en jours depuis la connexion (en plus
# des 30 jours d'inactivité) — audit sécurité lot 10.
SESSION_DUREE_ABSOLUE_JOURS=30

# Dossier des sauvegardes (scripts/backup_db.sh, scripts/restore_db.sh et
# sauvegarde automatique avant migration du service sauvegarde-migrations).
# Défaut : ./backups, DANS la copie de travail (un `git clean` ou le
# partage SMB peuvent l'effacer). Recommandé : un dossier hors du dépôt.
#KAIROS_BACKUP_DIR=/mnt/Pool/sauvegardes/kairos

# Envoi d'email — mot de passe oublié + mot de passe transmis à la
# création d'un compte (retour Fadhel, 2026-09-20). Tant que SMTP_HOST
# est vide, ces deux fonctionnalités sont simplement inactives (rien ne
# casse) : l'admin voit juste un avertissement "email non envoyé" et peut
# toujours communiquer le mot de passe autrement en attendant.
#
# Exemple avec une adresse Gmail (nécessite un "mot de passe d'application"
# généré dans les paramètres du compte Google, pas le mot de passe du
# compte) — adapter selon le fournisseur choisi :
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=ton-adresse@gmail.com
#   SMTP_PASSWORD=le-mot-de-passe-d-application
#   SMTP_FROM=ton-adresse@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true

# Mode test des e-mails (tant que Kairos est en test) : adresses et/ou
# domaines (@domaine), séparés par des virgules, casse ignorée. Si cette
# variable est renseignée, AUCUN e-mail ne part vers une autre adresse :
# l'envoi est bloqué, journalisé dans `docker compose logs web` (adresse
# masquée, sans le contenu) et l'écran dit que l'e-mail n'est pas parti
# (« Envoyer un lien de réinitialisation », création de compte, « Mot de
# passe oublié »). Vide ou absente : comportement normal. Exemple :
#   MAIL_DESTINATAIRES_AUTORISES=gerant@exemple.tn,kairos@midgardengineering.com
#   MAIL_DESTINATAIRES_AUTORISES=@midgardengineering.com
MAIL_DESTINATAIRES_AUTORISES=

# Mode test de Kairos (lot 12) — pour les Admins seulement, tant que Kairos
# est en test :
#   - « Agir comme… » : utiliser Kairos AU NOM d'un autre compte (posts,
#     tâches, Daily log, états…), chaque modification étant tracée à son
#     nom ET au nom de l'Admin dans le journal d'audit ;
#   - date simulée : faire comme si on était un autre jour (Daily log,
#     retards, Deadlines, rappels…), pour la session de l'Admin seulement.
# « Voir comme… » (lecture seule) existe toujours, même à false.
# Seule la valeur true active le mode test ; toute autre valeur le coupe.
# À REMETTRE À false AVANT LA MISE EN SERVICE RÉELLE, puis :
#   sudo docker compose up -d
KAIROS_MODE_TEST=false

# Compression gzip faite par l'appli (pages, JSON, CSS, JS > 1 Ko). Mettre
# false si le reverse proxy compresse déjà les réponses (lot 11).
COMPRESSION_GZIP=true

# Notifications Windows (Web Push, lot 24) — Kairos installé comme une
# application (Chrome / Edge : « Installer ») affiche ses notifications dans
# Windows. Clés produites UNE fois sur le serveur :
#   sudo docker compose exec web flask cles-push
# (copier les deux lignes affichées ici), puis :
#   sudo docker compose up -d
# VAPID_SUJET : adresse de contact donnée aux services push (Google,
# Microsoft). Vides : aucune notification Windows, l'appli marche comme
# avant. Ne jamais mettre ces clés dans le dépôt ; en changer désabonne
# tous les PC (chacun réactive dans « Mes informations »).
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
VAPID_SUJET=mailto:kairos@midgardengineering.com
