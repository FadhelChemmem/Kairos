.env.*
!.env.example
uploads/
backups/
*.egg-info/
.venv/
.DS_Store

# Sorties de scripts/migrate_from_chronos.py, et dumps de l'ancien Kairos
# déposés ici pour être migrés : contiennent des données personnelles
# réelles (noms, téléphones, adresses) et des mots de passe temporaires en
# clair — jamais dans git (voir l'incident .env du 2026-09-19, à ne jamais
# reproduire).
migration_sorties/
identifiants*NE_PAS_COMMITER*.csv
chronos_*.sql
migration.sql
# Sorties datées de la migration du 2026-09-21, posées à la racine (audit
# du 2026-10-01) : même contenu sensible que ci-dessus.
migration_kairos_*.sql
rapport_migration_*.md
identifiants_*.csv
# Sorties de scripts/recharger_projets_chronos.py (données réelles).
recharge_chronos_*.sql
recharge_chronos_*.md

# Captures d'écran de vérification posées à la racine par erreur (une
# s'était retrouvée dans le dépôt et dans l'image Docker, audit du
# 2026-09-29) — les images de l'appli sont dans app/static/img/. Lot 10 :
# où qu'elles soient (sous-dossiers compris), sauf dans app/static/img/.
*.png
*.jpg
*.jpeg
!/app/static/img/*

# Fichiers déposés à la racine de la copie de travail (exports Excel,
# documents, dumps, identifiants...) : jamais dans git (audits sécurité I16
# et QA I7, lot 10). Les fichiers SQL versionnés sont réintégrés
# explicitement.
/*.xlsx
/*.xls
/*.docx
/*.doc
/*.pdf
/*.csv
/*.sql
!/schema.sql
*.sql.gz
*.tar.gz
*.dump
*.backup
.deploiement_en_cours
